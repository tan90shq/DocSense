# ==============================================================================
# DocSense (NEXUS) Environment Configuration Template
# ==============================================================================
# Duplicate this file as `.env` in the project root or backend folder and fill
# in your own API credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq API Configuration (Fast LPU Inference)
# ------------------------------------------------------------------------------
# Used for: Multi-query expansion, grounded synthesis, continuous chat summary,
# and automatic session titling (e.g. openai/gpt-oss-120b, openai/gpt-oss-20b).
# Obtain an API key from: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# ------------------------------------------------------------------------------
# 2. Qdrant Cloud Vector Database Configuration
# ------------------------------------------------------------------------------
# Used for: Isolated per-document collections, 384-dimensional dense vector
# indexing (all-MiniLM-L6-v2), and similarity search.
# Obtain cluster URL & API key from: https://cloud.qdrant.io/
# Example URL: "https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io"
QDRANT_URL="https://your-cluster-id.region.cloud.qdrant.io"
QDRANT_API_KEY="your_qdrant_api_key_here"

# ------------------------------------------------------------------------------
# 3. Frontend API Base URL (Used by Vite frontend client)
# ------------------------------------------------------------------------------
# Set this in frontend/.env or as an environment variable for Vite.
# Default backend port: 8001
VITE_API_BASE_URL="http://localhost:8001"
